# Copy to .env and fill in with your database's details.

# Postgres (external database the backend connects to)
PG_HOST=
PG_USER=
PG_PASS=
PG_DB=
PG_PORT=5432

# Event whose stats the backend queries
EVENT_ID=

# Base URL the frontend (browser) uses to reach the backend API
VITE_API_URL=http://localhost:4505/api
